{
  "manifest_version": 3,
  "name": "미리캔버스 요소 상위노출 순위",
  "version": "1.0.0",
  "description": "요소와 작가 이름을 검색하여 노출 순위를 조회합니다.",
  "action": {
    "default_popup": "index.html",
    "default_title": "순위 조회",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "host_permissions": ["https://api.miricanvas.com/*"]
}
